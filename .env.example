# Copy this file to .env and fill in real values. .env itself is gitignored
# and should never be committed - this file is just the template.

# Postgres connection - see README for local setup (creating the role/database).
DB_HOST=localhost
DB_NAME=photography_ecommerce_rails_development
DB_USER=photography_ecommerce_rails
DB_PASSWORD=

# Get these from your Stripe dashboard in test mode:
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Printed by `stripe listen --forward-to localhost:3000/stripe/webhooks`
# each time it starts.
STRIPE_WEBHOOK_SECRET=whsec_...
