#!/usr/bin/env bash
# Runs ON THE PROD SERVER (invoked over SSH by .github/workflows/ci.yml's deploy job
set -euo pipefail

# Non-interactive SSH sessions (like appleboy/ssh-action's) don't source
# ~/.bashrc, so rbenv's shims never make it onto PATH otherwise - bundle/ruby
# would be "command not found" even though they work fine in a normal login.
export PATH="$HOME/.rbenv/shims:$HOME/.rbenv/bin:$PATH"

APP_DIR=/var/www/photography_ecommerce_rails
ENV_FILE="$APP_DIR/.env.production"
SERVICE=photography_ecommerce_rails-puma

cd "$APP_DIR"

git fetch origin main
git reset --hard origin/main

set -a
source "$ENV_FILE"
set +a

bundle config set --local deployment 'true'
bundle config set --local without 'development test'
bundle install
bin/rails db:migrate
bin/rails assets:precompile

sudo systemctl restart "$SERVICE"
sudo systemctl is-active --quiet "$SERVICE"
