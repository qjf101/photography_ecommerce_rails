<%= link_to product, id: dom_id(product), class: "product-card", data: { masonry_target: "item" } do %>
  <% if product.images.attached? %>
    <%= image_tag product.images.first, class: "product-card__image", alt: product.name %>
  <% else %>
    <div class="product-card__image product-card__image--placeholder"></div>
  <% end %>

  <span class="visually-hidden"><%= product.name %> — <%= number_to_currency(product.price_cents / 100.0) %></span>
<% end %>
