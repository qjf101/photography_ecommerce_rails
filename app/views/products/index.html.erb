<% content_for :title, "Products" %>
<% content_for :container_class, "container--wide" %>

<h1>Gallery</h1>

<div id="products" data-controller="masonry">
  <% if @products.any? %>
    <% @products.each do |product| %>
      <%= render product %>
    <% end %>
  <% else %>
    <p>No products available.</p>
  <% end %>
</div>
