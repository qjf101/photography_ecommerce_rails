<%= form_with(model: product, url: (product.new_record? ? admin_products_path : admin_product_path(product))) do |form| %>
  <% if product.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul>
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :price_cents, style: "display: block" %>
    <%= form.text_field :price_cents %>
  </div>

  <div>
    <%= form.label :active, style: "display: block" %>
    <%= form.checkbox :active %>
  </div>

  <div>
    <%= form.label :images, "Add images", style: "display: block" %>
    <%= form.file_field :images, multiple: true %>
  </div>

  <% if product.persisted? && product.images.attached? %>
    <div>
      <strong>Current images:</strong>
      <% product.images.each do |image| %>
        <%= image_tag image, width: 100 %>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= form.submit %>
  </div>
<% end %>
