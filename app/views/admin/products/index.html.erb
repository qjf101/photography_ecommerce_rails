<% content_for :title, "Admin - Products" %>

<h1>Products</h1>

<%= link_to "New product", new_admin_product_path %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Price</th>
      <th>Active</th>
      <th colspan="2"></th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>
        <td><%= number_to_currency(product.price_cents / 100.0) %></td>
        <td><%= product.active? ? "Yes" : "No" %></td>
        <td><%= link_to "Edit", edit_admin_product_path(product) %></td>
        <td><%= button_to "Destroy", admin_product_path(product), method: :delete %></td>
      </tr>
    <% end %>
  </tbody>
</table>
